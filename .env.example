# ETC Labs — Gen 1 · backend configuration. Copy to .env and fill in. NEVER commit .env.
# (Variable names only — no real values live in this file.)

# Admin login. Generate the hash with:  python -m server.cli set-admin-password
ETC_ADMIN_USER=admin
ETC_ADMIN_PASSWORD_HASH=

# 32+ random characters used to sign admin session cookies.
# If empty, a key is generated once into data/.secret_key (fine locally; set it explicitly in production).
ETC_SECRET_KEY=

# Frontend origin(s) allowed to call the public submission API cross-origin, comma-separated.
# Needed when the site is on GitHub Pages and the backend is elsewhere.
ETC_ALLOWED_ORIGINS=https://etcofficials.github.io

# Set to 1 when the backend is served over HTTPS (marks the admin cookie Secure). Production: 1
ETC_SECURE_COOKIES=0

# Where the SQLite database, resume uploads and logs live (default: ./data). Production: a persistent disk.
# ETC_DATA_DIR=/var/data

# Optional: server-side Discord notification for new submissions (never sent to the browser)
ETC_DISCORD_WEBHOOK_URL=

ETC_MAX_UPLOAD_MB=5
ETC_SESSION_HOURS=12
