# ETC Labs — Gen 1 · backend configuration. Copy to .env and fill in. NEVER commit .env.
# (Variable names only — no real values live in this file.)

# ---- Admin login (required). Generate the hash with:  python -m server.cli set-admin-password
ETC_ADMIN_USER=admin
ETC_ADMIN_PASSWORD_HASH=

# ---- Sessions: 32+ random characters used to sign admin session cookies.
# If empty, a key is generated once into data/.secret_key (fine locally; set it explicitly in production).
ETC_SECRET_KEY=

# ---- Frontend origin(s) allowed to call the public API cross-origin, comma-separated.
# Defaults to the GitHub Pages origin of this project when unset.
ETC_ALLOWED_ORIGINS=https://etcofficials.github.io

# ---- Set to 1 when the backend is served over HTTPS (marks the admin cookie Secure). Production: 1
ETC_SECURE_COOKIES=0

# ---- Where the SQLite database, resumes, transfers and logs live (default: ./data).
# Production: a persistent disk, e.g. /var/data on Render. Without it, data is wiped on every deploy.
# ETC_DATA_DIR=/var/data

# ---- Public site URL used in links the backend generates (transfer links, room links).
ETC_SITE_URL=https://etcofficials.github.io/etc-labs-gen-1

# ---- AI Utilities (optional). Server-side only; never reaches the browser. Without it the tool shows "not enabled".
ETC_ANTHROPIC_API_KEY=
ETC_AI_MODEL=claude-opus-5

# ---- Voice Rooms (optional). STUN is built in; add a TURN relay for strict NATs/corporate networks.
ETC_TURN_URL=
ETC_TURN_USER=
ETC_TURN_PASS=

# ---- Notifications (optional, server-side). Email needs all of SMTP_HOST, NOTIFY_FROM and NOTIFY_TO.
ETC_DISCORD_WEBHOOK_URL=
ETC_SMTP_HOST=
ETC_SMTP_PORT=587
ETC_SMTP_USER=
ETC_SMTP_PASS=
ETC_SMTP_TLS=1
ETC_NOTIFY_FROM=
ETC_NOTIFY_TO=

# ---- Limits
ETC_MAX_UPLOAD_MB=5
ETC_TRANSFER_MAX_MB=25
ETC_SESSION_HOURS=12
